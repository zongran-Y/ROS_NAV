FROM vision-agent-nav:gpu
ENV DEBIAN_FRONTEND=noninteractive
ENV TURTLEBOT3_MODEL=waffle_pi
ENV GAZEBO_MODEL_PATH=/root/.gazebo/models:/opt/ros/humble/share/turtlebot3_gazebo/models
ENV QT_QPA_PLATFORM=offscreen
ENV LIBGL_ALWAYS_SOFTWARE=1
RUN apt-get update && apt-get install -y --no-install-recommends xvfb xauth && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-gazebo-ros-pkgs ros-humble-nav2-bringup ros-humble-turtlebot3 \
    ros-humble-turtlebot3-gazebo ros-humble-turtlebot3-navigation2 \
    ros-humble-robot-state-publisher ros-humble-tf2-ros \
    mesa-utils libgl1-mesa-dri && rm -rf /var/lib/apt/lists/*
COPY models/gazebo_models/ /root/.gazebo/models/
WORKDIR /opt/ros_ws/src/vision_agent_nav
COPY . /opt/ros_ws/src/vision_agent_nav
WORKDIR /opt/ros_ws
RUN bash -lc 'source /opt/ros/humble/setup.bash && colcon build --symlink-install --packages-select vision_agent_nav'
ENTRYPOINT ["bash", "-lc", "source /opt/ros/humble/setup.bash && source /opt/ros_ws/install/setup.bash && exec xvfb-run -a ros2 launch vision_agent_nav vision_agent_bringup.launch.py gui:=false enable_perception:=false"]
